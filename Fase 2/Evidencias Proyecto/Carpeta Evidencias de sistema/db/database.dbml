Project aj_connect {
  database_type: 'PostgreSQL'
  Note: 'Esquema basado en los modelos Django actuales; incluye tablas propias y tablas estándar referenciadas por AUTH_USER_MODEL.'
}

// Autenticación de Django (AUTH_USER_MODEL = auth.User).
Table auth_user {
  id int [pk, increment]
  password varchar(128) [not null]
  last_login timestamptz
  is_superuser boolean [not null]
  username varchar(150) [unique, not null]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff boolean [not null]
  is_active boolean [not null]
  date_joined timestamptz [not null]
}

Table roles {
  id bigint [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(100) [not null]
  description text
  created_at timestamptz [not null]
}

Table user_roles {
  id bigint [pk, increment]
  user_id int [not null]
  role_id bigint [not null]
  assigned_at timestamptz [not null]

  indexes {
    (user_id, role_id) [unique]
  }
}

Table authentication_userprofile {
  id bigint [pk, increment]
  user_id int [unique, not null]
  rut varchar(12) [unique]
  phone varchar(20)
}

Table notification_channels {
  id int [pk, increment]
  code varchar(20) [unique, not null]
  name varchar(50) [not null]
  created_at timestamptz [not null]
}

Table clients {
  id uuid [pk]
  rut varchar(12) [unique, not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(20) [not null]
  email varchar(255)
  password_hash varchar(255) [not null]
  notification_channel_id int [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table client_otps {
  id bigint [pk, increment]
  client_id uuid [unique, not null]
  code_hash varchar(128) [not null]
  expires_at timestamptz [not null]
  last_sent_at timestamptz [not null]
  attempts smallint [not null]
  consumed_at timestamptz
  verified_at timestamptz
}

Table clientprofilechange {
  id bigint [pk, increment]
  client_id uuid [unique, not null]
  payload jsonb [not null]
  email_at_request varchar(254) [not null]
  code_hash varchar(128) [not null]
  expires_at timestamptz [not null]
  last_sent_at timestamptz [not null]
  attempts smallint [not null]
  consumed_at timestamptz
}

Table vehicle_brands {
  id int [pk, increment]
  name varchar(50) [unique, not null]
  created_at timestamptz [not null]
}

Table vehicle_models {
  id int [pk, increment]
  brand_id int [not null]
  name varchar(50) [not null]
  created_at timestamptz [not null]

  indexes {
    (brand_id, name) [unique]
  }
}

Table vehicles {
  id uuid [pk]
  client_id uuid [not null]
  model_id int [not null]
  plate varchar(10) [unique, not null]
  year int [not null]
  color varchar(30)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table services {
  id bigint [pk, increment]
  name varchar(150) [unique, not null]
  description text [not null]
  base_price numeric(12,2)
  estimated_duration_minutes int
  is_active boolean [not null]
}

Table workshop_appointmentslot {
  scheduled_date timestamptz [pk]
}

Table appointments {
  id uuid [pk]
  client_id uuid [not null]
  vehicle_id uuid
  service_id bigint
  status varchar(10) [not null, default: 'PENDIENTE', note: 'Choices: PENDIENTE, CONFIRMADA, CANCELADA, RECHAZADA, ATENDIDA']
  scheduled_date timestamptz [not null]
  slot_number smallint [not null, default: 1]
  reported_symptoms text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (scheduled_date, slot_number) [unique, note: 'Índice único parcial: solo para citas no CANCELADA ni RECHAZADA']
  }
}

Table work_order_statuses {
  id bigint [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(50) [not null]
  sequence_order int [not null]
  created_at timestamptz [not null]
}

Table work_orders {
  id uuid [pk]
  appointment_id uuid [unique]
  folio_number int [unique, not null]
  tracking_code varchar(14) [unique, not null]
  tracking_token varchar(32) [unique, not null]
  vehicle_id uuid [not null]
  assigned_mechanic_id int
  status_id bigint [not null]
  client_observations text
  technical_diagnosis text
  ai_diagnostic_suggestion text
  estimated_delivery_date timestamptz
  closed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table work_order_checkins {
  id uuid [pk]
  work_order_id uuid [unique, not null]
  receptionist_id int
  initial_odometer int
  fuel_level varchar(20) [not null]
  has_spare_tire boolean
  has_jack_and_tools boolean
  bodywork_details text
  additional_equipment jsonb [not null]
  created_at timestamptz [not null]
}

Table work_order_photos {
  id uuid [pk]
  checkin_id uuid [not null]
  photo_cloudinary_url text [not null]
  public_id varchar(100)
  created_at timestamptz [not null]
}

Table work_order_items {
  id uuid [pk]
  work_order_id uuid [not null]
  item_id uuid [not null]
  added_by_user_id int
  quantity int [not null]
  request_id uuid
  unit_price numeric(12,2) [not null]
  created_at timestamptz [not null]

  indexes {
    (work_order_id, request_id) [unique]
  }
}

Table work_order_status_history {
  id uuid [pk]
  work_order_id uuid [not null]
  from_status_id bigint
  to_status_id bigint [not null]
  changed_by_id int
  notes text
  changed_at timestamptz [not null]
}

Table quotes {
  id uuid [pk]
  work_order_id uuid
  client_id uuid [not null]
  subtotal_amount numeric(12,2) [not null, default: 0]
  tax_rate numeric(5,2) [not null, default: 0]
  tax_amount numeric(12,2) [not null, default: 0]
  total_amount numeric(12,2) [not null]
  is_approved boolean [not null, default: false]
  pdf_cloudinary_url text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table quote_items {
  id uuid [pk]
  quote_id uuid [not null]
  item_id uuid [not null]
  quantity int [not null]
  unit_price numeric(12,2) [not null]
  created_at timestamptz [not null]
}

Table item_categories {
  id bigint [pk, increment]
  name varchar(100) [unique, not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
}

Table inventory_items {
  id uuid [pk]
  category_id bigint [not null]
  sku varchar(50) [unique, not null]
  name varchar(150) [not null]
  description text
  unit_price numeric(12,2) [not null]
  current_stock int [not null, default: 0]
  minimum_stock int [not null, default: 5]
  is_published boolean [not null, default: false]
  public_title varchar(150)
  public_description text
  public_price numeric(10,0)
  public_image varchar(100)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table workshop_bookingverification {
  id uuid [pk]
  rut varchar(12) [not null]
  payload_hash varchar(64) [not null]
  code_hash varchar(128) [not null]
  expires_at timestamptz [not null]
  attempts smallint [not null]
  consumed_at timestamptz

  indexes {
    rut
  }
}

Table workshop_emaildelivery {
  id uuid [pk]
  payload jsonb [not null]
  kind varchar(20) [not null]
  target_id uuid [not null]
  status varchar(12) [not null, default: 'PENDING']
  attempts smallint [not null]
  available_at timestamptz [not null]
  locked_at timestamptz
  last_error varchar(255) [not null]
  created_at timestamptz [not null]
  sent_at timestamptz

  indexes {
    (kind, target_id) [unique, note: 'Índice único parcial solo cuando kind = welcome']
    available_at
  }
}

Table demand_forecast_snapshots {
  id uuid [pk]
  period varchar(10) [not null]
  start_date date [not null]
  end_date date [not null]
  forecast jsonb [not null]
  generated_at timestamptz [not null]

  indexes {
    (period, start_date, end_date) [unique]
    generated_at
  }
}

// Inventario no contiene un modelo de movimientos en el código actual.
Ref: user_roles.user_id > auth_user.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: authentication_userprofile.user_id - auth_user.id [delete: cascade]
Ref: clients.notification_channel_id > notification_channels.id
Ref: client_otps.client_id - clients.id [delete: cascade]
Ref: clientprofilechange.client_id - clients.id [delete: cascade]
Ref: vehicle_models.brand_id > vehicle_brands.id [delete: cascade]
Ref: vehicles.client_id > clients.id [delete: cascade]
Ref: vehicles.model_id > vehicle_models.id [delete: restrict]
Ref: appointments.client_id > clients.id [delete: restrict]
Ref: appointments.vehicle_id > vehicles.id [delete: restrict]
Ref: appointments.service_id > services.id [delete: restrict]
Ref: work_orders.appointment_id - appointments.id [delete: restrict]
Ref: work_orders.vehicle_id > vehicles.id [delete: restrict]
Ref: work_orders.assigned_mechanic_id > auth_user.id [delete: set null]
Ref: work_orders.status_id > work_order_statuses.id [delete: restrict]
Ref: work_order_checkins.work_order_id - work_orders.id [delete: cascade]
Ref: work_order_checkins.receptionist_id > auth_user.id [delete: set null]
Ref: work_order_photos.checkin_id > work_order_checkins.id [delete: cascade]
Ref: work_order_items.work_order_id > work_orders.id [delete: cascade]
Ref: work_order_items.item_id > inventory_items.id [delete: restrict]
Ref: work_order_items.added_by_user_id > auth_user.id [delete: set null]
Ref: work_order_status_history.work_order_id > work_orders.id [delete: cascade]
Ref: work_order_status_history.from_status_id > work_order_statuses.id [delete: set null]
Ref: work_order_status_history.to_status_id > work_order_statuses.id [delete: restrict]
Ref: work_order_status_history.changed_by_id > auth_user.id [delete: set null]
Ref: quotes.work_order_id > work_orders.id [delete: set null]
Ref: quotes.client_id > clients.id [delete: restrict]
Ref: quote_items.quote_id > quotes.id [delete: cascade]
Ref: quote_items.item_id > inventory_items.id [delete: restrict]
Ref: inventory_items.category_id > item_categories.id [delete: restrict]

