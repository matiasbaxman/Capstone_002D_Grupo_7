Project aj_connect {
  database_type: 'PostgreSQL'
  Note: 'A&J Connect - Sistema de Gestión y Portal PWA (A&J Automotriz)'
}

// =============================================================
// MÓDULO 1: AUTENTICACIÓN Y SEGURIDAD INTERNA
// =============================================================

Table roles [headercolor: #6b7280] {
  id int [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(100) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table users [headercolor: #6b7280] {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  rut varchar(12) [unique]
  phone varchar(20)
  is_active boolean [not null, default: true]
  last_login timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_roles [headercolor: #6b7280] {
  user_id uuid [not null]
  role_id int [not null]
  assigned_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_id) [pk]
  }
}

Table user_shifts [headercolor: #6b7280] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  shift_start timestamptz [not null, default: `now()`]
  shift_end timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table audit_actions [headercolor: #6b7280] {
  id int [pk, increment]
  code varchar(50) [unique, not null]
  description varchar(150)
  created_at timestamptz [not null, default: `now()`]
}

Table audit_logs [headercolor: #6b7280] {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid
  action_id int [not null]
  entity_name varchar(100) [not null]
  entity_id varchar(100)
  old_values "jsonb"
  new_values "jsonb"
  ip_address varchar(45)
  user_agent text
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================
// MÓDULO 2: CLIENTES, VEHÍCULOS Y CITAS (PORTAL PWA)
// =============================================================

Table notification_channels [headercolor: #0d9488] {
  id int [pk, increment]
  code varchar(20) [unique, not null]
  name varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table clients [headercolor: #0d9488] {
  id uuid [pk, default: `gen_random_uuid()`]
  rut varchar(12) [unique, not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(20) [not null]
  email varchar(255)
  password_hash varchar(255) [not null]
  notification_channel_id int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vehicle_brands [headercolor: #0d9488] {
  id int [pk, increment]
  name varchar(50) [unique, not null]
  created_at timestamptz [not null, default: `now()`]
}

Table vehicle_models [headercolor: #0d9488] {
  id int [pk, increment]
  brand_id int [not null]
  name varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (brand_id, name) [unique]
  }
}

Table vehicles [headercolor: #0d9488] {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [not null]
  model_id int [not null]
  plate varchar(10) [unique, not null]
  year int [not null]
  color varchar(30)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table appointment_statuses [headercolor: #0d9488] {
  id int [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table appointments [headercolor: #0d9488] {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [not null]
  vehicle_id uuid
  status_id int [not null]
  scheduled_date timestamptz [not null]
  reported_symptoms text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// =============================================================
// MÓDULO 3: INVENTARIO
// =============================================================

Table item_categories [headercolor: #7c3aed] {
  id int [pk, increment]
  name varchar(100) [unique, not null]
  created_at timestamptz [not null, default: `now()`]
}

Table inventory_items [headercolor: #7c3aed] {
  id uuid [pk, default: `gen_random_uuid()`]
  category_id int [not null]
  sku varchar(50) [unique, not null]
  name varchar(150) [not null]
  description text
  unit_price "numeric(12,2)" [not null]
  current_stock int [not null, default: 0]
  minimum_stock int [not null, default: 5]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table movement_types [headercolor: #7c3aed] {
  id int [pk, increment]
  code varchar(20) [unique, not null]
  name varchar(50) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table inventory_movements [headercolor: #7c3aed] {
  id uuid [pk, default: `gen_random_uuid()`]
  item_id uuid [not null]
  user_id uuid
  movement_type_id int [not null]
  quantity int [not null]
  previous_stock int [not null]
  new_stock int [not null]
  reference_id uuid
  notes text
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================
// MÓDULO 4: ÓRDENES DE TRABAJO (OT)
// =============================================================

Table work_order_statuses [headercolor: #b5601f] {
  id int [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(50) [not null]
  sequence_order int [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table work_orders [headercolor: #b5601f] {
  id uuid [pk, default: `gen_random_uuid()`]
  folio_number int [unique, increment]
  tracking_token varchar(32) [unique, not null]
  vehicle_id uuid [not null]
  assigned_mechanic_id uuid
  status_id int [not null]
  client_observations text
  technical_diagnosis text
  estimated_delivery_date timestamptz
  closed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table work_order_checkins [headercolor: #b5601f] {
  id uuid [pk, default: `gen_random_uuid()`]
  work_order_id uuid [unique, not null]
  receptionist_id uuid
  initial_odometer int [not null]
  fuel_level varchar(20) [not null, note: 'Texto libre definido por el mecánico/recepcionista; validado en la app, no en la BD']
  has_spare_tire boolean [default: true]
  has_jack_and_tools boolean [default: true]
  bodywork_details text
  created_at timestamptz [not null, default: `now()`]
}

Table work_order_photos [headercolor: #b5601f] {
  id uuid [pk, default: `gen_random_uuid()`]
  checkin_id uuid [not null]
  photo_cloudinary_url text [not null]
  public_id varchar(100)
  created_at timestamptz [not null, default: `now()`]
}

Table work_order_items [headercolor: #b5601f] {
  id uuid [pk, default: `gen_random_uuid()`]
  work_order_id uuid [not null]
  item_id uuid [not null]
  added_by_user_id uuid
  quantity int [not null]
  unit_price "numeric(12,2)" [not null, note: 'Precio congelado al momento de agregarlo']
  created_at timestamptz [not null, default: `now()`]
}

Table work_order_status_history [headercolor: #b5601f] {
  id uuid [pk, default: `gen_random_uuid()`]
  work_order_id uuid [not null]
  status_id int [not null]
  changed_by_user_id uuid
  notes text
  created_at timestamptz [not null, default: `now()`]
}

Table quotes [headercolor: #b5601f] {
  id uuid [pk, default: `gen_random_uuid()`]
  work_order_id uuid
  client_id uuid [not null]
  total_amount "numeric(12,2)" [not null]
  is_approved boolean [default: false]
  pdf_cloudinary_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table quote_items [headercolor: #b5601f] {
  id uuid [pk, default: `gen_random_uuid()`]
  quote_id uuid [not null]
  item_id uuid [not null]
  quantity int [not null]
  unit_price "numeric(12,2)" [not null]
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================
// RELACIONES
// =============================================================

Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: user_shifts.user_id > users.id [delete: cascade]
Ref: audit_logs.user_id > users.id [delete: set null]
Ref: audit_logs.action_id > audit_actions.id

Ref: clients.notification_channel_id > notification_channels.id
Ref: vehicle_models.brand_id > vehicle_brands.id
Ref: vehicles.client_id > clients.id
Ref: vehicles.model_id > vehicle_models.id
Ref: appointments.client_id > clients.id [delete: cascade]
Ref: appointments.vehicle_id > vehicles.id [delete: set null]
Ref: appointments.status_id > appointment_statuses.id

Ref: inventory_items.category_id > item_categories.id
Ref: inventory_movements.item_id > inventory_items.id
Ref: inventory_movements.user_id > users.id [delete: set null]
Ref: inventory_movements.movement_type_id > movement_types.id

Ref: work_orders.vehicle_id > vehicles.id
Ref: work_orders.assigned_mechanic_id > users.id [delete: set null]
Ref: work_orders.status_id > work_order_statuses.id
Ref: work_order_checkins.work_order_id - work_orders.id [delete: cascade]
Ref: work_order_checkins.receptionist_id > users.id [delete: set null]
Ref: work_order_photos.checkin_id > work_order_checkins.id [delete: cascade]
Ref: work_order_items.work_order_id > work_orders.id [delete: cascade]
Ref: work_order_items.item_id > inventory_items.id
Ref: work_order_items.added_by_user_id > users.id [delete: set null]
Ref: work_order_status_history.work_order_id > work_orders.id [delete: cascade]
Ref: work_order_status_history.status_id > work_order_statuses.id
Ref: work_order_status_history.changed_by_user_id > users.id [delete: set null]
Ref: quotes.work_order_id > work_orders.id [delete: set null]
Ref: quotes.client_id > clients.id [delete: restrict]
Ref: quote_items.quote_id > quotes.id [delete: cascade]
Ref: quote_items.item_id > inventory_items.id
