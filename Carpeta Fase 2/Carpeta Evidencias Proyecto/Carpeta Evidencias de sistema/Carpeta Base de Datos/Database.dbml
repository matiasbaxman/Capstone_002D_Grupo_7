Project aj_connect {
  database_type: 'PostgreSQL'
  Note: 'A&J Connect. Esquema de aplicación de Django, con auth_user. Excluye las tablas internas de administración, permisos, sesiones, migraciones, caché y tokens de Django.'
}

// Los defaults definidos en Python se aplican en Django. No son defaults de PostgreSQL.
// Los índices parciales y las clases de operador se detallan en comentarios para conservar su semántica.

// Usuarios y roles

Table auth_user [headercolor: #6b7280] {
  id integer [pk, increment, not null]
  password varchar(128) [not null]
  last_login timestamptz
  is_superuser boolean [not null]
  username varchar(150) [not null, unique]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff boolean [not null]
  is_active boolean [not null]
  date_joined timestamptz [not null]

  // CREATE INDEX "auth_user_username_6821ab7c_like" ON "auth_user" ("username" varchar_pattern_ops);

  Note: 'Usuarios del personal en Django. Los clientes del portal se registran en clients.'
}

Table roles [headercolor: #6b7280] {
  id bigint [pk, increment, not null]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  description text
  created_at timestamptz [not null]

  // CREATE INDEX "roles_code_e726c310_like" ON "roles" ("code" varchar_pattern_ops);
}

Table user_roles [headercolor: #6b7280] {
  id bigint [pk, increment, not null]
  user_id integer [not null]
  role_id bigint [not null]
  assigned_at timestamptz [not null]

  indexes {
    user_id [name: 'user_roles_user_id_9d9f8dbb']
    role_id [name: 'user_roles_role_id_816a4486']
    (user_id, role_id) [unique, name: 'user_roles_user_id_role_id_69bfd9a0_uniq']
  }
}

Table authentication_userprofile [headercolor: #6b7280] {
  id bigint [pk, increment, not null]
  user_id integer [not null, unique]
  rut varchar(12) [unique]
  phone varchar(20)

  // CREATE INDEX "authentication_userprofile_rut_70394a13_like" ON "authentication_userprofile" ("rut" varchar_pattern_ops);
}

// Clientes, vehículos y citas

Table notification_channels [headercolor: #0d9488] {
  id bigint [pk, increment, not null]
  code varchar(20) [not null, unique]
  name varchar(50) [not null]
  created_at timestamptz [not null]

  // CREATE INDEX "notification_channels_code_d3b94b44_like" ON "notification_channels" ("code" varchar_pattern_ops);
}

Table clients [headercolor: #0d9488] {
  id uuid [pk, not null]
  rut varchar(12) [not null, unique]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(20) [not null, note: 'Contacto único cuando se informa. Se ignoran separadores y variantes del prefijo móvil chileno.']
  email varchar(255) [note: 'Contacto único cuando se informa, sin distinguir mayúsculas ni espacios exteriores.']
  password_hash varchar(255) [not null]
  notification_channel_id bigint [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    notification_channel_id [name: 'clients_notification_channel_id_a4407f2d']
    (`NULLIF(LOWER(TRIM("email")), '')`) [unique, name: 'client_contact_email_unique']
    (`NULLIF(CASE WHEN length(translate(phone, '+ -.()', '')) = 11 AND left(translate(phone, '+ -.()', ''), 3) = '569' THEN right(translate(phone, '+ -.()', ''), 9) WHEN length(translate(phone, '+ -.()', '')) = 8 THEN '9' || translate(phone, '+ -.()', '') ELSE translate(phone, '+ -.()', '') END, '')`) [unique, name: 'client_contact_phone_unique']
  }

  // CREATE INDEX "clients_rut_9c5999a0_like" ON "clients" ("rut" varchar_pattern_ops);
}

Table client_otps [headercolor: #0d9488] {
  id bigint [pk, increment, not null]
  client_id uuid [not null, unique]
  code_hash varchar(128) [not null]
  expires_at timestamptz [not null]
  last_sent_at timestamptz [not null]
  attempts smallint [not null]
  consumed_at timestamptz
  verified_at timestamptz

  checks {
    `"attempts" >= 0`
  }
}

Table vehicle_brands [headercolor: #0d9488] {
  id bigint [pk, increment, not null]
  name varchar(50) [not null, unique]
  created_at timestamptz [not null]

  // CREATE INDEX "vehicle_brands_name_f710fe31_like" ON "vehicle_brands" ("name" varchar_pattern_ops);
}

Table vehicle_models [headercolor: #0d9488] {
  id bigint [pk, increment, not null]
  brand_id bigint [not null]
  name varchar(50) [not null]
  created_at timestamptz [not null]

  indexes {
    brand_id [name: 'vehicle_models_brand_id_389d576d']
    (brand_id, name) [unique, name: 'vehicle_models_brand_id_name_4e623963_uniq']
  }
}

Table vehicles [headercolor: #0d9488] {
  id uuid [pk, not null]
  client_id uuid [not null]
  model_id bigint [not null]
  plate varchar(10) [not null, unique]
  year integer [not null]
  color varchar(30)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    client_id [name: 'vehicles_client_id_816e65bd']
    model_id [name: 'vehicles_model_id_3575af00']
  }

  // CREATE INDEX "vehicles_plate_640856b3_like" ON "vehicles" ("plate" varchar_pattern_ops);
}

Table services [headercolor: #0d9488] {
  id bigint [pk, increment, not null]
  name varchar(150) [not null, unique]
  description text [not null]
  base_price numeric(12,2)
  estimated_duration_minutes integer
  is_active boolean [not null]
  is_bookable boolean [not null]

  checks {
    `("base_price" >= 0 OR "base_price" IS NULL)` [name: 'service_nonnegative_price']
    `("estimated_duration_minutes" >= 1 OR "estimated_duration_minutes" IS NULL)` [name: 'service_positive_duration']
    `"estimated_duration_minutes" >= 0`
  }

  // CREATE INDEX "services_name_73647d7e_like" ON "services" ("name" varchar_pattern_ops);
}

Table workshop_appointmentslot [headercolor: #0d9488] {
  scheduled_date timestamptz [pk, not null]

  Note: 'Registro de bloqueo para asignar los cupos de un horario. No existe una clave foránea entre esta tabla y appointments.'
}

Table appointments [headercolor: #0d9488] {
  id uuid [pk, not null]
  client_id uuid [not null]
  vehicle_id uuid
  service_id bigint
  status varchar(10) [not null]
  scheduled_date timestamptz [not null]
  slot_number smallint [not null, note: 'Número de cupo asignado por Django. El taller admite dos cupos por horario.']
  reported_symptoms text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    client_id [name: 'appointments_client_id_ed088e20']
    vehicle_id [name: 'appointments_vehicle_id_95ecdeba']
    service_id [name: 'appointments_service_id_00b454f1']
    scheduled_date [name: 'appointments_scheduled_date_ffc17ede']
  }

  checks {
    `("slot_number" >= 1 AND "slot_number" <= 2)` [name: 'appointment_slot_one_or_two']
    `"slot_number" >= 0`
  }

  // CREATE UNIQUE INDEX "unique_active_appointment_capacity" ON "appointments" ("scheduled_date", "slot_number") WHERE NOT ("status" IN ('CANCELADA', 'RECHAZADA'));

  Note: 'Estado definido mediante TextChoices. La restricción unique_active_appointment_capacity es parcial y aplica a citas distintas de CANCELADA o RECHAZADA.'
}

Table workshop_bookingverification [headercolor: #0d9488] {
  id uuid [pk, not null]
  rut varchar(12) [not null]
  payload_hash varchar(64) [not null]
  code_hash varchar(128) [not null]
  expires_at timestamptz [not null]
  attempts smallint [not null]
  consumed_at timestamptz

  indexes {
    rut [name: 'workshop_bookingverification_rut_2880f6a4']
  }

  checks {
    `"attempts" >= 0`
  }

  // CREATE INDEX "workshop_bookingverification_rut_2880f6a4_like" ON "workshop_bookingverification" ("rut" varchar_pattern_ops);
}

Table workshop_clientprofilechange [headercolor: #0d9488] {
  id bigint [pk, increment, not null]
  client_id uuid [not null, unique]
  payload jsonb [not null]
  email_at_request varchar(254) [not null]
  code_hash varchar(128) [not null]
  expires_at timestamptz [not null]
  last_sent_at timestamptz [not null]
  attempts smallint [not null]
  consumed_at timestamptz

  checks {
    `"attempts" >= 0`
  }
}

// Inventario y catálogo web

Table item_categories [headercolor: #7c3aed] {
  id bigint [pk, increment, not null]
  name varchar(100) [not null, unique]
  is_active boolean [not null]
  created_at timestamptz [not null]

  // CREATE INDEX "item_categories_name_3bf12d82_like" ON "item_categories" ("name" varchar_pattern_ops);
}

Table item_brands [headercolor: #7c3aed] {
  id bigint [pk, increment, not null]
  name varchar(100) [not null]
  is_active boolean [not null]

  indexes {
    (`LOWER(TRIM("name"))`) [unique, name: 'item_brand_name_unique']
  }

  checks {
    `NOT TRIM("name") = ''` [name: 'item_brand_name_required']
  }
}

Table inventory_items [headercolor: #7c3aed] {
  id uuid [pk, not null]
  category_id bigint [not null]
  brand_id bigint [not null, note: 'Obligatorio. La migración usa Marca por identificar para insumos anteriores sin marca registrada.']
  sku varchar(50) [not null, unique]
  name varchar(150) [not null]
  description text
  unit_price numeric(12,2) [not null]
  current_stock integer [not null]
  minimum_stock integer [not null]
  is_published boolean [not null]
  public_title varchar(150)
  public_description text
  public_price numeric(10,0)
  public_image varchar(500) [note: 'URL HTTPS de Cloudinary o ruta conservada de una imagen local anterior.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    category_id [name: 'inventory_items_category_id_12ebef3a']
    brand_id [name: 'inventory_items_brand_id_cd65411e']
    category_id [name: 'idx_inv_items_cat']
    sku [name: 'idx_inv_sku']
  }

  // CREATE INDEX "inventory_items_sku_6a2f462b_like" ON "inventory_items" ("sku" varchar_pattern_ops);
}

// Órdenes de trabajo

Table work_order_statuses [headercolor: #b5601f] {
  id bigint [pk, increment, not null]
  code varchar(30) [not null, unique]
  name varchar(50) [not null]
  sequence_order integer [not null]
  created_at timestamptz [not null]

  // CREATE INDEX "work_order_statuses_code_412b9622_like" ON "work_order_statuses" ("code" varchar_pattern_ops);
}

Table work_orders [headercolor: #b5601f] {
  appointment_id uuid [unique, note: 'Una cita puede originar una sola OT. Una OT puede registrarse sin cita.']
  id uuid [pk, not null]
  folio_number integer [not null, unique]
  tracking_code varchar(14) [not null, unique, note: 'Código público de seguimiento.']
  tracking_token varchar(32) [not null, unique]
  vehicle_id uuid [not null]
  assigned_mechanic_id integer
  status_id bigint [not null]
  client_observations text
  technical_diagnosis text
  ai_diagnostic_suggestion text
  estimated_delivery_date timestamptz
  closed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    vehicle_id [name: 'work_orders_vehicle_id_24c6a3d5']
    assigned_mechanic_id [name: 'work_orders_assigned_mechanic_id_2ffffcbb']
    status_id [name: 'work_orders_status_id_7fda857c']
  }

  // CREATE INDEX "work_orders_tracking_code_d1de3930_like" ON "work_orders" ("tracking_code" varchar_pattern_ops);
  // CREATE INDEX "work_orders_tracking_token_7734ba64_like" ON "work_orders" ("tracking_token" varchar_pattern_ops);
}

Table work_order_checkins [headercolor: #b5601f] {
  id uuid [pk, not null]
  work_order_id uuid [not null, unique]
  receptionist_id integer
  initial_odometer integer
  fuel_level varchar(20) [not null]
  has_spare_tire boolean
  has_jack_and_tools boolean
  bodywork_details text
  additional_equipment jsonb [not null, note: 'Equipamiento y estado observados al ingresar el vehículo.']
  created_at timestamptz [not null]

  indexes {
    receptionist_id [name: 'work_order_checkins_receptionist_id_b29afd1e']
  }

  checks {
    `"initial_odometer" >= 0`
  }
}

Table work_order_photos [headercolor: #b5601f] {
  id uuid [pk, not null]
  checkin_id uuid [not null]
  photo_cloudinary_url text [not null]
  public_id varchar(100)
  created_at timestamptz [not null]

  indexes {
    checkin_id [name: 'work_order_photos_checkin_id_5c0b2084']
  }
}

Table work_order_items [headercolor: #b5601f] {
  id uuid [pk, not null]
  work_order_id uuid [not null]
  item_id uuid [not null]
  added_by_user_id integer
  quantity integer [not null]
  request_id uuid
  unit_price numeric(12,2) [not null, note: 'Importe unitario registrado al asociar el insumo.']
  created_at timestamptz [not null]

  indexes {
    work_order_id [name: 'work_order_items_work_order_id_b3ef70d0']
    item_id [name: 'work_order_items_item_id_997470b9']
    added_by_user_id [name: 'work_order_items_added_by_user_id_21f2470c']
    (work_order_id, request_id) [unique, name: 'unique_order_item_request']
  }

  checks {
    `"quantity" >= 0`
  }
}

Table work_order_status_history [headercolor: #b5601f] {
  id uuid [pk, not null]
  work_order_id uuid [not null]
  from_status_id bigint
  to_status_id bigint [not null]
  changed_by_id integer
  notes text
  changed_at timestamptz [not null]

  indexes {
    work_order_id [name: 'work_order_status_history_work_order_id_ad2b43ac']
    from_status_id [name: 'work_order_status_history_from_status_id_34c6d727']
    to_status_id [name: 'work_order_status_history_to_status_id_05a0ea31']
    changed_by_id [name: 'work_order_status_history_changed_by_id_0c79e392']
  }

  Note: 'Registra el estado anterior y el nuevo. El estado vigente se consulta en work_orders.'
}

// Cotizaciones

Table quotes [headercolor: #b5601f] {
  id uuid [pk, not null]
  work_order_id uuid
  client_id uuid [not null]
  subtotal_amount numeric(12,2) [not null]
  service_name varchar(250) [not null, note: 'Nombre y descripción del servicio al emitir la cotización.']
  service_amount numeric(12,2) [note: 'Monto neto del servicio al emitir la cotización.']
  tax_rate numeric(5,2) [not null]
  tax_amount numeric(12,2) [not null]
  total_amount numeric(12,2) [not null]
  is_approved boolean [not null]
  pdf_cloudinary_url text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    work_order_id [name: 'quotes_work_order_id_06bc779a']
    client_id [name: 'quotes_client_id_689522ba']
  }

  checks {
    `("subtotal_amount" >= 0 AND "tax_amount" >= 0 AND "total_amount" >= 0)` [name: 'quote_nonnegative_amounts']
    `("tax_rate" >= 0 AND "tax_rate" <= 100)` [name: 'quote_valid_tax_rate']
    `"total_amount" = ("subtotal_amount" + "tax_amount")` [name: 'quote_total_consistent']
    `(("service_amount" IS NULL AND "service_name" = '') OR (NOT ("service_name" = '') AND "service_amount" >= 0 AND "service_amount" IS NOT NULL))` [name: 'quote_service_snapshot_consistent']
  }
}

Table quote_items [headercolor: #b5601f] {
  id uuid [pk, not null]
  quote_id uuid [not null]
  item_id uuid [not null]
  brand_name varchar(100) [not null, note: 'Marca registrada al emitir la cotización.']
  quantity integer [not null]
  unit_price numeric(12,2) [not null, note: 'Importe unitario registrado al emitir la cotización.']
  created_at timestamptz [not null]

  indexes {
    quote_id [name: 'quote_items_quote_id_7f336f92']
    item_id [name: 'quote_items_item_id_7bfb60c4']
  }

  checks {
    `("quantity" >= 1 AND "unit_price" >= 0)` [name: 'quote_item_positive_values']
    `"quantity" >= 0`
  }
}

// Notificaciones y proyección

Table workshop_emaildelivery [headercolor: #3b678b] {
  id uuid [pk, not null]
  payload jsonb [not null]
  kind varchar(20) [not null]
  target_id uuid [not null]
  status varchar(12) [not null]
  attempts smallint [not null]
  available_at timestamptz [not null]
  locked_at timestamptz
  last_error varchar(255) [not null]
  created_at timestamptz [not null]
  sent_at timestamptz

  indexes {
    available_at [name: 'workshop_emaildelivery_available_at_47a5fdea']
  }

  checks {
    `"attempts" >= 0`
  }

  // CREATE UNIQUE INDEX "unique_client_welcome_notification" ON "workshop_emaildelivery" ("kind", "target_id") WHERE "kind" = 'welcome';

  Note: 'Cola de notificaciones. kind indica el tipo de entidad referida por target_id. La unicidad unique_client_welcome_notification solo aplica a kind = welcome.'
}

Table demand_forecast_snapshots [headercolor: #3b678b] {
  id uuid [pk, not null]
  period varchar(10) [not null]
  start_date date [not null]
  end_date date [not null]
  forecast jsonb [not null]
  generated_at timestamptz [not null]

  indexes {
    generated_at [name: 'demand_forecast_snapshots_generated_at_42d65a49']
    (period, start_date, end_date) [unique, name: 'unique_demand_forecast_period_range']
  }

  Note: 'Resultado de proyección almacenado por tipo de período y rango.'
}

// Las acciones de borrado indicadas las aplica el ORM de Django.
Ref: user_roles.user_id > auth_user.id // Django CASCADE
Ref: user_roles.role_id > roles.id // Django CASCADE
Ref: auth_user.id - authentication_userprofile.user_id // Django CASCADE
Ref: clients.notification_channel_id > notification_channels.id // Django PROTECT
Ref: clients.id - client_otps.client_id // Django CASCADE
Ref: vehicle_models.brand_id > vehicle_brands.id // Django CASCADE
Ref: vehicles.client_id > clients.id // Django CASCADE
Ref: vehicles.model_id > vehicle_models.id // Django PROTECT
Ref: appointments.client_id > clients.id // Django PROTECT
Ref: appointments.vehicle_id > vehicles.id // Django PROTECT
Ref: appointments.service_id > services.id // Django PROTECT
Ref: clients.id - workshop_clientprofilechange.client_id // Django CASCADE
Ref: inventory_items.category_id > item_categories.id // Django PROTECT
Ref: inventory_items.brand_id > item_brands.id // Django PROTECT
Ref: appointments.id - work_orders.appointment_id // Django PROTECT
Ref: work_orders.vehicle_id > vehicles.id // Django PROTECT
Ref: work_orders.assigned_mechanic_id > auth_user.id // Django SET_NULL
Ref: work_orders.status_id > work_order_statuses.id // Django PROTECT
Ref: work_orders.id - work_order_checkins.work_order_id // Django CASCADE
Ref: work_order_checkins.receptionist_id > auth_user.id // Django SET_NULL
Ref: work_order_photos.checkin_id > work_order_checkins.id // Django CASCADE
Ref: work_order_items.work_order_id > work_orders.id // Django CASCADE
Ref: work_order_items.item_id > inventory_items.id // Django PROTECT
Ref: work_order_items.added_by_user_id > auth_user.id // Django SET_NULL
Ref: work_order_status_history.work_order_id > work_orders.id // Django CASCADE
Ref: work_order_status_history.from_status_id > work_order_statuses.id // Django SET_NULL
Ref: work_order_status_history.to_status_id > work_order_statuses.id // Django PROTECT
Ref: work_order_status_history.changed_by_id > auth_user.id // Django SET_NULL
Ref: quotes.work_order_id > work_orders.id // Django SET_NULL
Ref: quotes.client_id > clients.id // Django PROTECT
Ref: quote_items.quote_id > quotes.id // Django CASCADE
Ref: quote_items.item_id > inventory_items.id // Django PROTECT
